NODE_ENV=development
PORT=4050

# Either use DATABASE_URL or the split DATABASE_* variables.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_NAME=postgres
# DATABASE_USER=postgres
# DATABASE_PASSWORD=postgres

# SellerKG writes only to APP_SCHEMA. Existing WB data is read from WB_DATA_SCHEMA.
APP_SCHEMA=sellerkg
WB_DATA_SCHEMA=wb_prod

COLLECTORS_ENABLED=false
COLLECTOR_TICK_MS=60000
CORS_ORIGIN=http://localhost:5173
